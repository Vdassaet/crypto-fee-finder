# ChainRecover AI Environment Configuration
PORT=3000
NODE_ENV=production

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chainrecover_db?schema=public"

# Security & Authentication Secrets
JWT_SECRET="chainrecover_ai_super_secret_jwt_key_2026"
ENCRYPTION_SECRET="chainrecover_ai_encryption_key_32_bytes_long!"

# AI Assistant OpenAI Integration (Optional)
OPENAI_API_KEY=""

# Fee Collection — Platform wallet that receives service fees from recovered SOL
# Set this to YOUR Solana public key (Base58). Example: 7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU
FEE_WALLET_ADDRESS=""
# Percentage fee charged on recovered rent (RefundYourSOL uses 15%)
FEE_PERCENT=15

# Solana RPC Endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# High-Speed RPC Node Endpoints (Optional, recommended for production)
HELIUS_SOLANA_RPC="https://mainnet.helius-rpc.com/?api-key="
FLASHBOTS_ETH_RPC="https://rpc.flashbots.net"
ALCHEMY_ARBITRUM_RPC="https://arb-mainnet.g.alchemy.com/v2/"

